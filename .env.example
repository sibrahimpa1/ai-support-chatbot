# Copy to .env and fill in. Without a key the app runs in offline demo mode.

# auto = use Claude when ANTHROPIC_API_KEY is set, otherwise the offline mock provider
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high: support chat is latency-sensitive, low is usually enough
ANTHROPIC_EFFORT=low

COMPANY_NAME=Fernway Outdoor
# Confidence below which the bot hands the chat to a human (0..1)
ESCALATION_THRESHOLD=0.45
# Generate 30 days of sample conversations on first start (for the dashboard)
SEED_DEMO_DATA=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
